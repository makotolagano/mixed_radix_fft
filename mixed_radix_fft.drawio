        <mxCell id="fp-lbl-int" parent="1" style="text;html=1;fontSize=14;align=center;fontColor=#82b366;fontStyle=1;fontFamily=Garamond;" value="&lt;font face=&quot;Garamond&quot; style=&quot;font-size: 15px;&quot;&gt;Integer part (4 bits)&lt;br&gt;0101&lt;sub&gt;2&lt;/sub&gt; = 5&lt;/font&gt;" vertex="1">
