        <mxCell id="3la_fbcT0W-h1WRqY9lY-4" value="Control FSM" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="485" y="170" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g57uryHtonwi4X7HBV9U-1" value="&lt;div style=&quot;&quot;&gt;Digit Inversion Unit consists of:&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- Configuration Registers (CFG Regs),&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- Digit-inverted LUT Generator,&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- Digit-inverted LUT and&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- Control FSM.&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;The unit has the role of digit-inverting linear indices of FFT samples/bins (depends if&lt;/div&gt;&lt;div style=&quot;&quot;&gt;the reordering of data is done before or after the FFT). It should map every input index&lt;/div&gt;&lt;div style=&quot;&quot;&gt;n to the corresponding digit-inverted index m. With this in mind, data can be reordered&lt;/div&gt;&lt;div style=&quot;&quot;&gt;by using ping-pong buffering of input or output samples of FFT.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Data flow is as follows:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;- Digit Inversion Unit accepts configuration of Mixed-Radix FFT from an AXI Lite Master,&lt;div&gt;&lt;div style=&quot;&quot;&gt;- Configuration is written to CFG Regs and the cfg_valid signal is asserted,&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- LUT Generator detects the new configuration,&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- Calculation of output weights is triggered and when it&#39;s done w_calc_done signal is&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; asserted,&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- Digit inverter starts the calculation of inverted indices and writes them to the LUT.&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="200.75" y="417" width="483" height="314" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
