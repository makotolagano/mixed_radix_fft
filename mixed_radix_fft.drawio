        <mxCell id="fp-calc" parent="1" style="text;html=1;fontSize=15;align=center;fontFamily=Garamond;" value="&lt;font face=&quot;Garamond&quot;&gt;Value = 2&lt;sup&gt;2&lt;/sup&gt; + 2&lt;sup&gt;0&lt;/sup&gt; + 2&lt;sup&gt;-1&lt;/sup&gt; + 2&lt;sup&gt;-3&lt;/sup&gt; = 4 + 1 + 0.5 + 0.125 = 5.625&lt;br&gt;Range: [−8, +7.9375]&amp;nbsp;&amp;nbsp;&amp;nbsp;Resolution: 2&lt;sup&gt;-4&lt;/sup&gt; = 0.0625&lt;/font&gt;" vertex="1">
          <mxGeometry height="50" width="480" x="160" y="390" as="geometry" />
        </mxCell>
